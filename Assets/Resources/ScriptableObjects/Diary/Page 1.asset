  m_Script: {fileID: 11500000, guid: a2cdd91772f9b2a449d70192404c48e1, type: 3}
  m_Name: Page 1
  m_EditorClassIdentifier: Assembly-CSharp::DiaryPageSo
  pageTitle: Night 1
  pageContent: "My first night\u2026 strange but manageable.\n\nOne man said he thirsted
    for the river that bubbles in darkness, sweet yet bitter as sin. I gave him what
    sparkled, and his throat swallowed without sound.\n\nWhy did the air smell like
    smoke, though nothing burned?"
