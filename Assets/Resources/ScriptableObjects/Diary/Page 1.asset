  m_Script: {fileID: 11500000, guid: a2cdd91772f9b2a449d70192404c48e1, type: 3}
  m_Name: Page 1
  m_EditorClassIdentifier: Assembly-CSharp::DiaryPageSo
  pageTitle: Night 1
  pageContent: "My first night\u2026 strange but manageable.\n\nHe asked for the
    flame of day, captured between flesh and wheat. I hesitated, but gave him what
    felt right. His grin stretched too long. The lights trembled when he left.\n\nWhy
    did the air smell like smoke, though nothing burned?"
