  m_Script: {fileID: 11500000, guid: a2cdd91772f9b2a449d70192404c48e1, type: 3}
  m_Name: Page 2
  m_EditorClassIdentifier: Assembly-CSharp::DiaryPageSo
  pageTitle: Night 2
  pageContent: 'Colder tonight. Whispers behind my back, never a face.


    One
    man said he thirsted for the river that bubbles in darkness, sweet yet bitter
    as sin. I gave him what sparkled, and his throat swallowed without sound.


    I
    swear I heard fizzing even after the kiosk was silent.'
