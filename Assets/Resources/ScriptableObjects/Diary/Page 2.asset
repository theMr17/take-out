  m_Script: {fileID: 11500000, guid: a2cdd91772f9b2a449d70192404c48e1, type: 3}
  m_Name: Page 2
  m_EditorClassIdentifier: Assembly-CSharp::DiaryPageSo
  pageTitle: Night 2
  pageContent: "Colder tonight. Whispers behind my back, never a face.\n\nA pale
    man came, smiling too wide. He wanted the golden shards, countless, thin, born
    of oil\u2019s fire. I handed them over. He devoured every one, chewing long after
    the food was gone.\n\nI swear I heard fizzing even after the kiosk was silent."
