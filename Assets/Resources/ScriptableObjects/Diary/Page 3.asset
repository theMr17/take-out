  m_Script: {fileID: 11500000, guid: a2cdd91772f9b2a449d70192404c48e1, type: 3}
  m_Name: Page 3
  m_EditorClassIdentifier: Assembly-CSharp::DiaryPageSo
  pageTitle: Night 3
  pageContent: "Sleep won\u2019t come. Their teeth still crunch in my dreams.\n\nA
    pale woman came, smiling too wide. She wanted the golden shards, countless, thin,
    born of oil\u2019s fire. I handed them over. She devoured every one, chewing
    long after the food was gone.\n\nI still hear it. Crunch. Crunch. Crunch."
